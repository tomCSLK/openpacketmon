# Texts of the browser scripts (static/*.js). No Fluent variables: the script fills in %1, %2.
js-decimal = .
js-thousands = ,
js-date = YYYY-MM-DD
js-day = MM/DD
js-theme-system = Theme: system
js-theme-light = Theme: light
js-theme-dark = Theme: dark
js-theme-toggle = %1 (toggle)
js-chart-time = Time
js-chart-in = Incoming
js-chart-out = Outgoing
js-rate-now = now: %1 in, %2 out
js-packets-per-second = %1 packets/s
js-state-running = running
js-state-paused = paused
js-state-finished = file read completely
js-state-error = error
js-stats-traffic = Traffic
js-packets-none = No packets
js-packets-range = Packets %1–%2 of %3
js-packets-goto-other = Packet %1 is not in the list; packet %2 is marked.
js-packets-goto-none = Packet %1 is not in the list.
js-direction-out = outgoing
js-direction-in = incoming
