[Desktop Entry]
Version=1.0
Type=Application
Name=openpacketmon
Comment=Monitor your network traffic
Categories=Network;Utility;
Icon=openpacketmon
Exec=/usr/bin/openpacketmon-app
StartupWMClass=openpacketmon-app
Terminal=false
Keywords=traffic;inspect;monitor;internet;network;packet;
